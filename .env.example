# ==============================================================================
# Personalized LLM Knowledge Graph & Wiki — Environment Configuration
# ==============================================================================

# Directory containing historical Antigravity conversation transcripts
# - Default: ~/.gemini/antigravity/brain
# - Custom: set to your local session directory if using non-default path
AGENT_TRANSCRIPT_DIR=

# Optional: LLM API Keys (if running standalone ingestion/reduction scripts)
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Google Drive MCP Integration
# Set path to GCP OAuth client secret JSON and token directory
# GOOGLE_DRIVE_OAUTH_CREDENTIALS=
# GOOGLE_DRIVE_MCP_TOKEN_PATH=