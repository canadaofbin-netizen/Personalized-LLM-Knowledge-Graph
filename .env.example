# ==============================================================================
# Personalized LLM Knowledge Graph & Wiki — Environment Configuration
# ==============================================================================

# Agent Platform: antigravity | claude_code | cursor | generic
AGENT_PLATFORM=antigravity

# Directory containing historical agent conversation transcripts
# - Antigravity default: ~/.gemini/antigravity/brain
# - Claude Code default: ~/.claude/projects or ~/.claude/logs
# - Custom: set to your local session directory
AGENT_TRANSCRIPT_DIR=

# Optional: LLM API Keys (if running standalone ingestion/reduction scripts)
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key

# Optional: Google Drive MCP Integration
# Set path to GCP OAuth client secret JSON and token directory
# GOOGLE_DRIVE_OAUTH_CREDENTIALS=
# GOOGLE_DRIVE_MCP_TOKEN_PATH=